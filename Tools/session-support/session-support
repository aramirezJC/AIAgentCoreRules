#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from collections import Counter
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))

import session_monitor as monitor_module


def shared_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Portable local coding-agent session support.")
    parser.add_argument("--agent", choices=("codex", "claude", "gemini", "junie"))
    parser.add_argument("--project-config", type=Path, default=ROOT / "project.example.json")
    parser.add_argument("--sessions-root", type=Path)
    parser.add_argument("--since")
    return parser


def load_monitor(args: argparse.Namespace) -> monitor_module.SessionMonitor:
    config_path = args.project_config.expanduser().resolve()
    config = monitor_module.load_project_config(config_path)
    config["_base"] = str(config_path.parent)
    agent = args.agent or str(config.get("default_agent") or "codex")
    if args.sessions_root:
        sessions_root = args.sessions_root.expanduser()
    else:
        agent_config = dict((config.get("agents") or {}).get(agent) or {})
        configured = agent_config.get("sessions_root")
        if configured:
            sessions_root = monitor_module.configured_path(configured, config_path.parent)
        elif agent == "claude":
            sessions_root = Path.home() / ".claude" / "projects" / str(Path.cwd().resolve()).replace("/", "-")
        elif agent == "gemini":
            candidates = []
            for directory in (Path.home() / ".gemini" / "tmp").glob("*"):
                marker = directory / ".project_root"
                try:
                    if marker.read_text(encoding="utf-8").strip() == str(Path.cwd().resolve()):
                        candidates.append(directory)
                except OSError:
                    continue
            sessions_root = candidates[0] if candidates else Path.home() / ".gemini" / "tmp" / Path.cwd().name.lower()
        elif agent == "junie":
            sessions_root = Path.home() / ".junie" / "sessions"
        else:
            sessions_root = Path.home() / ".codex" / "sessions"
    since = monitor_module.parse_iso_timestamp(args.since) if args.since else None
    return monitor_module.SessionMonitor(sessions_root, since, agent=agent, project_config=config)


def support_report(session_monitor: monitor_module.SessionMonitor, scope: str = "last-30") -> dict:
    if scope == "current":
        snapshot = session_monitor.snapshot()
        history = [{
            "id": snapshot["session"]["id"],
            "repository": snapshot["source"]["project"],
            "started_at": snapshot["session"]["started_at"],
            "elapsed_seconds": snapshot["session"]["elapsed_seconds"],
            "completed_turns": snapshot["session"]["completed_turns"],
            "categories": snapshot["categories"],
            "total_tokens": snapshot["tokens"]["session"]["total_tokens"],
            "warning": snapshot["warning"]["severity"],
            "subagents": snapshot["subagents"]["active"] + snapshot["subagents"]["completed"] if snapshot["subagents"].get("available") else None,
        }]
    else:
        history = session_monitor.recent_sessions(limit=30 if scope == "last-30" else 100000)["sessions"]
    categories = Counter()
    warnings = Counter()
    total_tokens = 0
    token_sessions = 0
    for item in history:
        categories.update(item["categories"])
        warnings[item["warning"]] += 1
        if item["total_tokens"] is not None:
            total_tokens += item["total_tokens"]
            token_sessions += 1
    return {
        "contract_version": 1,
        "source": session_monitor.agent,
        "scope": scope,
        "session_count": len(history),
        "categories": dict(categories),
        "warnings": dict(warnings),
        "token_telemetry": {
            "available_sessions": token_sessions,
            "total_tokens": total_tokens if token_sessions else None,
        },
        "sessions": history,
    }


def markdown_report(report: dict) -> str:
    lines = [
        "# Session Support Report",
        "",
        f"- Agent: `{report['source']}`",
        f"- Scope: `{report['scope']}`",
        f"- Sessions: {report['session_count']}",
        f"- Total tokens: {report['token_telemetry']['total_tokens'] if report['token_telemetry']['total_tokens'] is not None else 'unavailable'}",
        "",
        "## Categories",
        "",
        "| Category | Turns |",
        "| --- | ---: |",
    ]
    lines.extend(f"| {name} | {count} |" for name, count in sorted(report["categories"].items(), key=lambda item: (-item[1], item[0])))
    lines.extend(["", "## Sessions", "", "| Repository | Started | Turns | Tokens | Warning |", "| --- | --- | ---: | ---: | --- |"])
    for item in report["sessions"]:
        lines.append(f"| {item.get('repository') or 'unknown'} | {item.get('started_at') or 'unknown'} | {item['completed_turns']} | {item['total_tokens'] if item['total_tokens'] is not None else 'unavailable'} | {item['warning']} |")
    return "\n".join(lines) + "\n"


def main(argv: list[str] | None = None) -> int:
    parser = shared_parser()
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("history", help="Print sanitized recent-session history.")
    report_parser = subparsers.add_parser("report", help="Generate sanitized JSON or Markdown support reports.")
    report_parser.add_argument("--scope", choices=("current", "last-30", "all"), default="last-30")
    report_parser.add_argument("--format", choices=("json", "markdown"), default="json")
    report_parser.add_argument("--output", type=Path)
    report_parser.add_argument("--include-content", action="store_true", help="Include prompts, responses, commands, and paths. Sensitive.")
    report_parser.add_argument(
        "--per-session",
        action="store_true",
        help="Also write one Markdown report per selected session. Requires --output directory.",
    )
    subparsers.add_parser("split", help="Print split advice for the active session.")
    monitor_args = subparsers.add_parser("monitor", help="Run the live terminal/dashboard monitor.")
    monitor_args.add_argument("monitor_args", nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)
    if args.command == "monitor":
        forwarded = ["--agent", args.agent] if args.agent else []
        forwarded += ["--project-config", str(args.project_config)]
        if args.sessions_root:
            forwarded += ["--sessions-root", str(args.sessions_root)]
        if args.since:
            forwarded += ["--since", args.since]
        return monitor_module.main([*forwarded, *(args.monitor_args or ["status"])])
    session_monitor = load_monitor(args)
    if args.command == "history":
        print(json.dumps(session_monitor.recent_sessions(limit=50), indent=2))
        return 0
    if args.command == "report":
        if args.per_session and args.format != "markdown":
            parser.error("--per-session requires --format markdown")
        if args.per_session and not args.output:
            parser.error("--per-session requires --output directory")
        if args.include_content:
            if args.format != "markdown":
                parser.error("--include-content currently requires --format markdown")
            generated = session_monitor.generated_report(args.scope, True)
            rendered = generated["content"]
            default_filename = generated["filename"]
        else:
            report = support_report(session_monitor, args.scope)
            rendered = json.dumps(report, indent=2) + "\n" if args.format == "json" else markdown_report(report)
            generated = session_monitor.generated_report(args.scope, False)
            default_filename = generated["filename"] if args.format == "markdown" else generated["filename"].removesuffix(".md") + ".json"
        if args.output:
            target = args.output.expanduser()
            if args.per_session:
                if target.exists() and not target.is_dir():
                    parser.error("--per-session requires --output directory")
                target.mkdir(parents=True, exist_ok=True)
                aggregate_target = target / default_filename
                session_reports = session_monitor.generated_session_reports(
                    args.scope,
                    args.include_content,
                )
                session_filenames = {report["filename"] for report in session_reports}
                if aggregate_target.name in session_filenames:
                    aggregate_target = aggregate_target.with_name(
                        aggregate_target.stem + "-aggregate" + aggregate_target.suffix
                    )
                aggregate_target.write_text(rendered, encoding="utf-8")
                print(aggregate_target)
                for session_report in session_reports:
                    session_target = target / session_report["filename"]
                    session_content = session_report["content"].replace(
                        "[Back To Aggregate Report](../README.md)",
                        f"[Back To Aggregate Report](./{aggregate_target.name})",
                    )
                    session_target.write_text(session_content, encoding="utf-8")
                    print(session_target)
                return 0
            if target.is_dir() or str(args.output).endswith("/"):
                target.mkdir(parents=True, exist_ok=True)
                target = target / default_filename
            target.write_text(rendered, encoding="utf-8")
            print(target)
        else:
            print(rendered, end="")
        return 0
    snapshot = session_monitor.snapshot()
    print(json.dumps({
        "contract_version": snapshot["contract_version"],
        "source": snapshot["source"],
        "session": snapshot["session"],
        "phase": snapshot["phase"],
        "categories": snapshot["categories"],
        "helpers": snapshot["helpers"],
        "warning": snapshot["warning"],
    }, indent=2))
    return 1 if snapshot["warning"]["severity"] in {"advisory", "split"} else 0


if __name__ == "__main__":
    raise SystemExit(main())
