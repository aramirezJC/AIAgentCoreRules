{
  "schema_version": 1,
  "default_agent": "codex",
  "agents": {
    "codex": {"sessions_root": "${HOME}/.codex/sessions"},
    "claude": {"sessions_root_note": "Defaults to the encoded current project under ~/.claude/projects."},
    "gemini": {"sessions_root_note": "Defaults to the matching .project_root directory under ~/.gemini/tmp."},
    "junie": {"sessions_root": "${HOME}/.junie/sessions"}
  },
  "category_config": "categories.example.json",
  "helper_path_prefixes": ["tools/", "scripts/"],
  "thresholds": {
    "turns": 20,
    "categories": 3,
    "helper_coverage": 0.25,
    "helper_min_turns": 8,
    "phases": 3,
    "context_ratio": 0.75
  },
  "state_root": "${HOME}/.engineering-session-monitor",
  "labels": {},
  "continuation": {
    "mode": "Mode: Builder",
    "system": "Project: ExampleProject",
    "goal": "Continue the current project work.",
    "constraints": "Preserve current behavior and verify the owning seam."
  }
}
