{
  "categories": [
    {
      "name": "review",
      "include": ["code review", "review the", "review this", "findings", "regression"],
      "exclude": ["implement", "fix this", "update the docs now"]
    },
    {
      "name": "doc-review",
      "include": ["doc", "docs", "documentation", "workplan", "changelog", "overview.md", "ai_context", "confluence"],
      "require_any": ["review", "compare", "stale", "up to date"]
    },
    {
      "name": "doc-maintenance",
      "include": ["doc", "docs", "documentation", "workplan", "changelog", "overview.md", "ai_context", "confluence"]
    },
    {
      "name": "debugging",
      "include": ["why is", "failing", "root cause", "repro", "debug", "trace", "investigate", "what's happening", "what is causing"]
    },
    {
      "name": "planning",
      "include": ["what are the options", "break down", "should we", "recommendation", "estimate", "plan", "open questions", "architecture"]
    },
    {
      "name": "tooling",
      "include": ["tool", "script", "guide", "report", "extractor", "dashboard", "validator", "command pack"]
    },
    {
      "name": "implementation",
      "include": ["implement", "fix", "update", "change", "patch", "create", "add", "build", "wire", "refactor"],
      "min_tool_calls": 8
    }
  ],
  "fallback_category": "other"
}
